{
    "name": "@cartesi/cli",
    "version": "2.0.0-alpha.4",
    "description": "Cartesi CLI",
    "author": "Danilo Tuler <tuler@pobox.com>",
    "bin": {
        "cartesi": "./dist/index.js"
    },
    "type": "module",
    "homepage": "https://github.com/cartesi/cli",
    "license": "Apache-2.0",
    "exports": "./dist/index.js",
    "repository": "cartesi/cli",
    "files": [
        "/bin",
        "/dist",
        "/npm-shrinkwrap.json"
    ],
    "dependencies": {
        "@commander-js/extra-typings": "^13.1.0",
        "@inquirer/confirm": "^5.0.0",
        "@inquirer/core": "^10.0.0",
        "@inquirer/input": "^4.0.0",
        "@inquirer/select": "^4.0.0",
        "@inquirer/type": "^3.0.0",
        "bytes": "^3.1.2",
        "chalk": "^5.3.0",
        "cli-table3": "^0.6.5",
        "commander": "^13.1.0",
        "execa": "^9.4.1",
        "fs-extra": "^11.2.0",
        "giget": "^1.2.3",
        "lookpath": "^1.2.2",
        "open": "^10.1.0",
        "ora": "^8.1.0",
        "progress-stream": "^2.0.0",
        "semver": "^7.6.3",
        "smol-toml": "^1.3.0",
        "tmp": "^0.2.3",
        "viem": "^2.21.27"
    },
    "devDependencies": {
        "@cartesi/devnet": "workspace:*",
        "@cartesi/eslint-config": "workspace:*",
        "@sunodo/wagmi-plugin-hardhat-deploy": "^0.3.0",
        "@types/bytes": "^3.1.4",
        "@types/fs-extra": "^11.0.4",
        "@types/inquirer": "^9.0.7",
        "@types/node": "^22.7.6",
        "@types/node-fetch": "^2.6.11",
        "@types/progress-stream": "^2.0.5",
        "@types/prompts": "^2.4.9",
        "@types/semver": "^7.5.8",
        "@types/tmp": "^0.2.6",
        "@vitest/coverage-istanbul": "^2.1.3",
        "@wagmi/cli": "^2.1.16",
        "copyfiles": "^2.4.1",
        "eslint": "^8.57.0",
        "npm-run-all": "^4.1.5",
        "rimraf": "^6.0.1",
        "ts-node": "^10.9.2",
        "tsconfig": "workspace:*",
        "tslib": "^2.8.0",
        "typescript": "^5.6.3",
        "vitest": "^2.1.3"
    },
    "scripts": {
        "build": "run-s clean codegen compile copy-files",
        "clean": "rimraf dist",
        "codegen": "run-p codegen:wagmi",
        "codegen:wagmi": "wagmi generate",
        "compile": "tsc -p tsconfig.build.json",
        "postcompile": "chmod +x dist/index.js",
        "copy-files": "copyfiles -u 1 \"src/**/*.yaml\" \"src/**/*.env\" \"src/**/*.txt\" dist",
        "lint": "eslint \"src/**/*.ts*\"",
        "posttest": "pnpm lint",
        "test": "vitest"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "bugs": "https://github.com/cartesi/cli/issues",
    "types": "dist/index.d.ts"
}
