{
    "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
    "assist": {
        "actions": {
            "source": {
                "organizeImports": "off"
            }
        }
    },
    "formatter": {
        "enabled": true,
        "includes": ["**", "!.changeset/pre.json", "!**/CHANGELOG.md"],
        "indentStyle": "space",
        "indentWidth": 4
    },
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "markdown": {
        "parser": {
            "frontmatter": true
        }
    }
}
