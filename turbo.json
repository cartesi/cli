{
    "$schema": "https://turbo.build/schema.json",
    "agentGuidance": false,
    "globalEnv": [
        "ALCHEMY_ID",
        "INFURA_ID",
        "MNEMONIC",
        "NETWORK",
        "NODE_ENV",
        "PORT",
        "PRIVATE_KEY",
        "RPC_URL",
        "TS_NODE_PROJECT"
    ],
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["build/**", "dist/**"]
        },
        "clean": {
            "cache": false
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "start": {
            "dependsOn": ["^build"]
        },
        "test": {
            "outputs": ["coverage/**"],
            "dependsOn": []
        }
    }
}
